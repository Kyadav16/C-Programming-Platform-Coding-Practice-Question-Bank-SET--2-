int strStr(char* haystack, char* needle) {
    int hLen = strlen(haystack);
    int nLen = strlen(needle);

    // If needle is longer than haystack, it cannot be a substring
    if (nLen > hLen) {
        return -1;
    }

    // Slide the window across haystack up to the last valid starting index
    for (int i = 0; i <= hLen - nLen; i++) {
        int j = 0;

        // Compare characters of needle against haystack starting at index i
        while (j < nLen && haystack[i + j] == needle[j]) {
            j++;
        }

        // If all characters matched, return the starting index
        if (j == nLen) {
            return i;
        }
    }

    return -1;
}
