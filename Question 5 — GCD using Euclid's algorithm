#include <stdio.h>

// Function to find the Greatest Common Divisor (GCD) using Euclid's algorithm
long long gcd(long long a, long long b) {
    // GCD is always positive, so convert negative inputs to positive
    if (a < 0) {
        a = -a;
    }
    if (b < 0) {
        b = -b;
    }

    // Repeat replacing (a, b) with (b, a % b) until b becomes 0
    while (b != 0) {
        long long remainder = a % b;
        a = b;
        b = remainder;
    }

    // When b is 0, 'a' holds the GCD
    return a;
}

int main() {
    long long a, b;

    // Read two integers a and b from the user
    scanf("%lld %lld", &a, &b);

    // Call the gcd function and print the result
    long long result = gcd(a, b);
    printf("%lld\n", result);

    return 0;
}
