void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    int i = m - 1;       // Pointer to the last valid element in nums1
    int j = n - 1;       // Pointer to the last element in nums2
    int k = m + n - 1;   // Pointer to the end of nums1

    // Merge from back to front so we never overwrite unprocessed elements in nums1
    while (i >= 0 && j >= 0) {
        if (nums1[i] > nums2[j]) {
            nums1[k] = nums1[i];
            i--;
        } else {
            nums1[k] = nums2[j];
            j--;
        }
        k--;
    }

    // Copy any remaining elements from nums2 (if nums1 ran out first)
    while (j >= 0) {
        nums1[k] = nums2[j];
        j--;
        k--;
    }
}
