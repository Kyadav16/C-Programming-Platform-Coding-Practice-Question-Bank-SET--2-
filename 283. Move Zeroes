void moveZeroes(int* nums, int numsSize) {
    int insertPos = 0;

    // Step 1: Shift all non-zero elements to the front in their original order
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != 0) {
            nums[insertPos] = nums[i];
            insertPos++;
        }
    }

    // Step 2: Fill the remaining positions with zeroes
    while (insertPos < numsSize) {
        nums[insertPos] = 0;
        insertPos++;
    }
}
