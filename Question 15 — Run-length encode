#include <stdio.h>
#include <string.h>

// Function to run-length encode a string (e.g., "aaabbc" -> "a3b2c1")
void runLengthEncode(const char str[]) {
    int len = (int)strlen(str);

    // Boundary check: if the string is empty, print a newline and stop
    if (len == 0) {
        printf("\n");
        return;
    }

    char currentChar = str[0];
    int count = 1;

    // Start from the second character (index 1) and compare with currentChar
    for (int i = 1; i < len; i++) {
        if (str[i] == currentChar) {
            // Same character continues: increase the run count
            count = count + 1;
        } else {
            // Character changed: print the previous character and its count
            printf("%c%d", currentChar, count);

            // Start tracking the new character with count 1
            currentChar = str[i];
            count = 1;
        }
    }

    // Print the very last character and its count when the loop finishes
    printf("%c%d\n", currentChar, count);
}

int main() {
    // Buffer large enough for standard competitive programming string lengths
    char str[10005];

    // Read a single word/string; if input is empty (EOF), handle cleanly
    if (scanf("%10004s", str) == 1) {
        runLengthEncode(str);
    } else {
        printf("\n");
    }

    return 0;
}
