#include <stdio.h>

// Function to count pairs (i < j) whose values add up to target
int countPairs(int n, long long arr[], long long target) {
    int count = 0;

    // Outer loop picks the first number at index i
    for (int i = 0; i < n; i++) {
        // Inner loop picks the second number at index j (always after i)
        for (int j = i + 1; j < n; j++) {
            if (arr[i] + arr[j] == target) {
                count = count + 1;
            }
        }
    }

    return count;
}

int main() {
    int n;
    long long target;

    // Read n (number of elements) and target sum
    scanf("%d %lld", &n, &target);

    // Boundary check: need at least 2 elements to form a pair
    if (n < 2) {
        printf("0\n");
        return 0;
    }

    // Create an array of size n and read all n integers
    long long arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%lld", &arr[i]);
    }

    // Call the function and print the total pairs found
    int result = countPairs(n, arr, target);
    printf("%d\n", result);

    return 0;
}
