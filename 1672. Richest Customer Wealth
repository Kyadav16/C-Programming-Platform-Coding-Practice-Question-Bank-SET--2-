int maximumWealth(int** accounts, int accountsSize, int* accountsColSize) {
    int maxWealth = 0;

    // Outer loop: go through each customer (each row)
    for (int i = 0; i < accountsSize; i++) {
        int currentCustomerWealth = 0;

        // Inner loop: add up money from all banks for this customer (each column)
        for (int j = 0; j < accountsColSize[i]; j++) {
            currentCustomerWealth = currentCustomerWealth + accounts[i][j];
        }

        // If this customer has more money than our highest record so far, update maxWealth
        if (currentCustomerWealth > maxWealth) {
            maxWealth = currentCustomerWealth;
        }
    }

    return maxWealth;
}
