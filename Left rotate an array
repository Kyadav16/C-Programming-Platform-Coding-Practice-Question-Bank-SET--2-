#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) != 2) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    if (arr == NULL) return 1;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Normalize d in case d >= n
    d = d % n;

    // Print the rotated array directly using modular indexing
    for (int i = 0; i < n; i++) {
        printf("%d", arr[(i + d) % n]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");

    free(arr);
    return 0;
}
