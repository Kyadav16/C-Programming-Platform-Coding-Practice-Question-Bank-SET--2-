int findNumbers(int* nums, int numsSize) {
    int evenDigitCount = 0;

    for (int i = 0; i < numsSize; i++) {
        int digits = 0;
        int temp = nums[i];

        // Count the number of digits by repeatedly dividing by 10
        while (temp > 0) {
            digits++;
            temp /= 10;
        }

        // Check if the digit count is even
        if (digits % 2 == 0) {
            evenDigitCount++;
        }
    }

    return evenDigitCount;
}
