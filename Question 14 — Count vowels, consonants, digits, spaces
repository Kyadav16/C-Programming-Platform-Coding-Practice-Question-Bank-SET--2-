#include <stdio.h>
#include <ctype.h>

// Function to count vowels, consonants, digits, and spaces in a string
void countCharacters(const char str[]) {
    int vowels = 0;
    int consonants = 0;
    int digits = 0;
    int spaces = 0;

    // Loop through each character until we hit the end of the string ('\0')
    for (int i = 0; str[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)str[i];

        if (ch == ' ') {
            spaces = spaces + 1;
        } 
        else if (isdigit(ch)) {
            digits = digits + 1;
        } 
        else if (isalpha(ch)) {
            // Convert letter to lowercase so we only need to check a, e, i, o, u
            char lower = (char)tolower(ch);

            if (lower == 'a' || lower == 'e' || lower == 'i' || lower == 'o' || lower == 'u') {
                vowels = vowels + 1;
            } else {
                consonants = consonants + 1;
            }
        }
        // Any other character (punctuation like '!', newline '\n', symbols) is ignored
    }

    printf("%d %d %d %d\n", vowels, consonants, digits, spaces);
}

int main() {
    // Buffer large enough to hold a full line of input
    char line[10005];

    // Use fgets instead of scanf("%s") so spaces are read properly
    if (fgets(line, sizeof(line), stdin) != NULL) {
        countCharacters(line);
    } else {
        // Boundary case: empty input (EOF with no characters)
        printf("0 0 0 0\n");
    }

    return 0;
}
