int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) return 0;

    int k = 1; // Index for the next unique element (index 0 is always unique)

    // Start scanning from the second element
    for (int i = 1; i < numsSize; i++) {
        // Since the array is sorted, any element different from the previous one is unique
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
