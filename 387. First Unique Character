int firstUniqChar(char* s) {
    int freq[26] = {0};

    // Pass 1: Count the frequency of each lowercase letter ('a' to 'z')
    for (int i = 0; s[i] != '\0'; i++) {
        freq[s[i] - 'a']++;
    }

    // Pass 2: Find the first character with a frequency of 1
    for (int i = 0; s[i] != '\0'; i++) {
        if (freq[s[i] - 'a'] == 1) {
            return i;
        }
    }

    return -1;
}
